# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# Virtualenv / env
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/

# Packaging / build
build/
dist/
eggs/
*.egg
.installed.cfg

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type check / caches
.mypy_cache/
.pytype/

# Django / local DB (safe to ignore generic DB files)
*.sqlite3
*.db

# Environment / secrets
.env
.env.*
local_settings.py
instance/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Celery
celerybeat-schedule
celerybeat.pid

# IDEs / editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git
*.orig

# Frontend (React) — ignore only local/build artifacts, not the whole frontend folder
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env
frontend/.env.*
frontend/.pnp/
frontend/.pnp.js

# If using pnpm workspaces
node_modules/.pnpm/

# Lockfiles and package files SHOULD be tracked (package-lock.json / yarn.lock / pnpm-lock.yaml)

# Misc
coverage/
*.cover
*.coverage
CLAUDE.md
