# =============================================================================
# Fleet SaaS - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env file to git!

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fleet

# =============================================================================
# Google OAuth 2.0
# =============================================================================
# Get these from: https://console.cloud.google.com/apis/credentials
# Both frontend and backend need the client ID
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# =============================================================================
# Backend
# =============================================================================
# These are set in backend/.env, but listed here for reference
# SECRET_KEY=your-secret-key-at-least-32-characters
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fleet
# REDIS_URL=redis://redis:6379/0
